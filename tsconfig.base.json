{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@samud/*": ["./packages/*/src/index.ts"],
      "@samud/database/*": ["./packages/database/src/*"],
      "@samud/ui/*": ["./packages/ui/src/*"],
      "@samud/config/*": ["./packages/config/src/*"],
      "@samud/types/*": ["./packages/types/src/*"]
    }
  }
}
