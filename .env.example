# ==============================================================================
# ENVIRONMENT & GENERAL SETTINGS
# ==============================================================================
NODE_ENV=development
PORT=4000
APP_NAME=Samud Shabkat
APP_URL=http://localhost:3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# [DEVELOPMENT] Neon Serverless PostgreSQL (Recommended for dev)
# Example: postgresql://[user]:[password]@[endpoint-id].us-east-2.aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# [PRODUCTION] Dedicated PostgreSQL Instance
# Example: postgres://postgres:your_prod_password@db.yourdomain.com:5432/samud_shabkat?sslmode=require
# DATABASE_URL=postgres://postgres:your_prod_password@localhost:5432/samud_shabkat

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=samud_shabkat
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false
DATABASE_MAX_CONNECTIONS=10

# ==============================================================================
# AUTHENTICATION & SECURITY
# ==============================================================================
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_12345
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_chars_12345
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ==============================================================================
# STORAGE & MEDIA UPLOADS
# Options for STORAGE_PROVIDER: "cloudinary" | "r2" | "auto"
# ==============================================================================
STORAGE_PROVIDER=cloudinary

# --- [DEVELOPMENT] Cloudinary Settings ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Alternative single connection URL:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# --- [PRODUCTION] Cloudflare R2 (S3-Compatible Object Storage) Settings ---
R2_ACCOUNT_ID=
R2_BUCKET_NAME=samud-shabkat-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Legacy alias support:
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=https://cdn.samudshabkat.com

# ==============================================================================
# EMAIL & NOTIFICATIONS
# ==============================================================================
RESEND_API_KEY=
EMAIL_FROM=Samud Shabkat <orders@samudshabkat.com>

# ==============================================================================
# FRONTEND / NEXT.JS PUBLIC CONFIGURATION
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_IMAGE_URL=https://cdn.samudshabkat.com
NEXT_PUBLIC_APP_NAME=Samud Shabkat
NEXT_PUBLIC_ENVIRONMENT=development
